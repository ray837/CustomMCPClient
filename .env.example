# ══════════════════════════════════════════════════════════════════
#  Advanced MCP Client — Environment Configuration
#  Copy this to .env and fill in your values
#  NEVER commit .env to git  →  add .env to .gitignore
# ══════════════════════════════════════════════════════════════════

# ── LLM Endpoint ──────────────────────────────────────────────────
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ── API Key ────────────────────────────────────────────────────────
# Get from https://console.groq.com → API Keys
# Rotate immediately if ever exposed in chat / git
OPENAI_API_KEY=

# ── Model ──────────────────────────────────────────────────────────
# Groq models that support tool/function calling:
#
#   llama-3.3-70b-versatile               <- RECOMMENDED (fast, great tool use)
#   llama3-groq-70b-8192-tool-use-preview <- fine-tuned specifically for tools
#   llama-3.1-70b-versatile               <- stable fallback
#   mixtral-8x7b-32768                    <- very fast, large context window
#   gemma2-9b-it                          <- lightweight / low-latency
#
MODEL_NAME=llama-3.3-70b-versatile

# ── Token & Loop Limits ────────────────────────────────────────────
MAX_TOKENS=4096
MAX_TOOL_ROUNDS=10

# ── SSL ────────────────────────────────────────────────────────────
# Groq uses valid TLS certs — keep this true
# Set to false ONLY for local servers with self-signed certs
SSL_VERIFY=true

# ── System Prompt ──────────────────────────────────────────────────
# Optional override — remove the # to activate
# SYSTEM_PROMPT=You are a precise AI assistant. Use tools when needed. Think step by step.

# ══════════════════════════════════════════════════════════════════
#  Alternative endpoints — uncomment the block you want
# ══════════════════════════════════════════════════════════════════

# ── OpenRouter (gpt-oss-120b, Claude, Gemini, etc.) ───────────────
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-your-openrouter-key
# MODEL_NAME=openai/gpt-oss-120b
# MODEL_NAME=openai/gpt-4o-mini
# MODEL_NAME=anthropic/claude-3-haiku
# MODEL_NAME=google/gemini-flash-1.5

# ── Ollama (local, no key needed) ─────────────────────────────────
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=none
# MODEL_NAME=llama3.1
# SSL_VERIFY=false

# ── LM Studio (local) ─────────────────────────────────────────────
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=none
# MODEL_NAME=local-model
# SSL_VERIFY=false

# ── vLLM (self-hosted) ────────────────────────────────────────────
# OPENAI_BASE_URL=http://your-vllm-host:8000/v1
# OPENAI_API_KEY=none
# MODEL_NAME=meta-llama/Meta-Llama-3-70B-Instruct
# SSL_VERIFY=false
